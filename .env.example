# Password entered on the login screen.
APP_PASSWORD=replace-with-a-login-password

# Server-side session signing secret. Keep it long and private.
API_TOKEN=replace-with-a-long-random-token
POSTGRES_USER=mileage
POSTGRES_PASSWORD=mileage_dev_password
POSTGRES_DB=mileage
FRONTEND_PORT=8088
API_PORT=18080
# Optional. Useful when the server needs PassWall or another proxy for Docker build npm installs.
NPM_PROXY=

# Optional OCR tuning.
OCR_TIMEOUT_MS=90000
OCR_MAX_UPLOAD_BYTES=8388608
OCR_OMP_NUM_THREADS=1
